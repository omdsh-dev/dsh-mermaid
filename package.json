{
  "name": "@shellraining/dsh-mermaid",
  "version": "0.5.9",
  "description": "Render Mermaid diagrams, switch between code and diagram views, and copy the source.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": [] }
  },
  "scripts": {
    "typecheck": "tsc -p tools/tsconfig.json && tsc -p tsconfig.json",
    "build": "pnpm run typecheck && node build.ts",
    "pack:check": "node tools/check-package.ts"
  },
  "packageManager": "pnpm@12.6.0",
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "engines": { "node": ">=22.19.0" },
  "author": "shellRaining",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omdsh-dev/dsh-mermaid.git"
  },
  "homepage": "https://github.com/omdsh-dev/dsh-mermaid#readme",
  "bugs": "https://github.com/omdsh-dev/dsh-mermaid/issues",
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin"],
  "publishConfig": { "access": "public" },
  "dependencies": { "mermaid": "11.17.2" },
  "icon": "./icon.png",
  "files": ["lib", "cordis.patch.yml", "icon.png", "locale", "README.md", "README.zh-CN.md", "LICENSE"]
}
